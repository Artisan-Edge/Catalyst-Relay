SAP_TEST_ADT_URL="https://hostname:port"
SAP_TEST_CLIENT="100"
SAP_TEST_USERNAME="USERABC"
SAP_TEST_PACKAGE="$TMP"
SAP_TEST_TRANSPORT=""
# System alias for keyring credential lookup (fallback when SAP_PASSWORD is not set).
# Reads credentials from OS keyring where Catalyst-CLI stores them.
# Store credentials with: catalyst systems add <alias>
SAP_TEST_SYSTEM_ALIAS=""
